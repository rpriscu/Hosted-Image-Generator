# ─────────────────────────────────────────────────────────────────────────────
# Hosted Image Generator — environment variables
#
# These are documented here for reference. NEVER put real values in a committed
# file. For local CLI use, copy this to `.env` (git-ignored). For the deployed
# Worker, set them as Wrangler secrets (see README "Deploy").
# ─────────────────────────────────────────────────────────────────────────────

# fal.ai API key (https://fal.ai/dashboard/keys). Auth header sent as: "Key <FAL_KEY>"
FAL_KEY=

# GitHub fine-grained PAT, scoped to Contents: Read+Write on the bucket repo ONLY.
# Used server-side to commit generated images via the Contents API.
GITHUB_TOKEN=

# Shared secret that gates the MCP OAuth consent screen. Anyone connecting the
# remote MCP server must enter this on the /authorize page before access is granted.
MCP_AUTH_SECRET=

# ── Bucket repo configuration ────────────────────────────────────────────────
# The PUBLIC repo that generated images are committed into.
GITHUB_OWNER=rpriscu
GITHUB_REPO=Hosted-Image-Generator
GITHUB_BRANCH=main

# For local CLI only (the Worker reads FAL_KEY/GITHUB_TOKEN from secrets):
# (no extra vars needed)
